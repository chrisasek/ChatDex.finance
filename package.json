{
  "name": "chatdex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace @chatdex/web",
    "build": "npm run build --workspace @chatdex/web",
    "package:cpanel": "npm run build && node scripts/package-cpanel.mjs",
    "package:database": "node scripts/package-database.mjs",
    "lint": "npm run lint --workspace @chatdex/web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "bootstrap": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@types/pg": "8.20.0",
    "pg": "8.16.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
